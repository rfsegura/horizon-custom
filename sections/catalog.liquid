{%- comment -%}
  Minimal catalog homepage: header bar (density "+", filters, bag) + product grid.
  Filters are blocks (blocks/_catalog-filter.liquid, up to 10, each with optional sub-filters). They
  show/hide tiles client-side, so the URL stays "/". Tiles are filtered by product tag (data-tags).
{%- endcomment -%}

<script
  type="module"
  src="{{ 'catalog-grid.js' | asset_url }}"
></script>
{%- liquid
  # The first filter is active on load; with no filters at all every product is shown.
  assign first_key = ''
  if section.blocks.size > 0
    assign first_tag = section.blocks.first.settings.tag | strip | downcase
    if first_tag != blank
      assign first_key = '|' | append: first_tag | append: '|'
    endif
  endif
-%}

<catalog-grid
  class="catalog"
  data-testid="catalog-{{ section.id }}"
  data-sub-trigger="{{ section.settings.sub_trigger }}"
  data-sub-logic="{{ section.settings.sub_logic }}"
>
  <header class="catalog__bar">
    <button
      type="button"
      class="catalog__btn button-unstyled"
      data-menu
      aria-label="Toggle grid size / back"
    >
      {% render 'catalog-menu-icon' %}
    </button>

    <div class="catalog__toggle" role="group" aria-label="Collection">
      {% content_for 'blocks' %}
    </div>

    {% render 'catalog-cart-button', class: 'catalog__btn catalog__cart' %}
  </header>

  {%- comment -%} ponytail: a for-loop outside a paginate block returns at most 50 products. Raise via paginate if the catalog grows. {%- endcomment -%}
  <ul class="catalog__grid" role="list" data-main-grid>
    {%- for product in section.settings.collection.products limit: 50 -%}
      {%- assign tags = product.tags | join: '|' | downcase | prepend: '|' | append: '|' -%}
      {%- assign in_first = true -%}
      {%- if first_key != blank -%}
        {%- unless tags contains first_key -%}{%- assign in_first = false -%}{%- endunless -%}
      {%- endif -%}

      {%- comment -%}
          One tile per Color option value (first available variant of that color, else its first variant).
          More than one color: the tile opens the color picker instead of the product page.
        {%- endcomment -%}
        {%- assign color_index = nil -%}
        {%- for option in product.options_with_values -%}
          {%- assign option_name = option.name | downcase -%}
          {%- if option_name == 'color' or option_name == 'colour' -%}
            {%- assign color_index = forloop.index0 -%}
          {%- endif -%}
        {%- endfor -%}

        {%- assign seen = '|' -%}
        {%- assign color_count = 0 -%}
        {%- capture color_tiles -%}
          {%- if color_index != nil -%}
            {%- for pass in (1..2) -%}
              {%- for variant in product.variants -%}
                {%- assign color = variant.options[color_index] -%}
                {%- assign color_key = color | downcase | prepend: '|' | append: '|' -%}
                {%- unless seen contains color_key -%}
                  {%- if pass == 2 or variant.available -%}
                    {%- assign seen = seen | append: color_key -%}
                    {%- assign color_count = color_count | plus: 1 -%}
                    <li class="catalog__tile">
                      {%- assign color_image = variant.featured_image | default: product.featured_image -%}
                      {%- assign color_alt = product.title | append: ' ' | append: color -%}
                      {% render 'catalog-tile', href: variant.url, image: color_image, title: product.title, alt: color_alt %}
                    </li>
                  {%- endif -%}
                {%- endunless -%}
              {%- endfor -%}
            {%- endfor -%}
          {%- endif -%}
        {%- endcapture -%}

        <li
          class="catalog__tile"
          data-tags="{{ tags | escape }}"
          {% unless in_first %}hidden{% endunless %}
        >
          {% render 'catalog-tile', href: product.url, image: product.featured_image, title: product.title, alt: product.title %}
          {%- if color_count > 1 -%}
            <template data-colors>{{ color_tiles }}</template>
          {%- endif -%}
        </li>
    {%- endfor -%}
  </ul>

  <ul class="catalog__grid" role="list" data-color-grid hidden></ul>
</catalog-grid>

<style>
  /* Catalog homepage replaces the theme header and announcement bar. */
  #header-group {
    display: none;
  }

  .catalog {
    --cols: 6;
    display: block;
    min-height: 100vh;
    padding: 0 var(--padding-lg, 16px) 48px;
    font-family: var(--font-body--family);
    font-size: 1.125rem;
    text-transform: uppercase;
  }

  .catalog[dense] {
    --cols: 3;
  }

  @media screen and (max-width: 749px) {
    .catalog {
      --cols: 3;
    }

    .catalog[dense] {
      --cols: 2;
    }
  }

  .catalog__bar {
    position: sticky;
    top: 0;
    z-index: 4;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 16px 0 40px;
    background: var(--color-background);
  }

  .catalog__toggle {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 24px;
  }

  .catalog__filter {
    position: relative;
  }

  /* Sub-filter menu: under its filter, shown on hover or after a click (section setting). */
  .catalog__sub {
    position: absolute;
    top: 100%;
    left: 50%;
    z-index: 5;
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    translate: -50% 0;
    background: #fff;
    white-space: nowrap;
    animation: catalog-fade 0.2s ease both;
  }

  .catalog__filter[data-open] > .catalog__sub:has(*) {
    display: flex;
  }

  @media (hover: hover) {
    .catalog[data-sub-trigger='hover'] .catalog__filter:is(:hover, :has(:focus-visible)) > .catalog__sub:has(*) {
      display: flex;
    }
  }

  .catalog__sub-btn {
    font: inherit;
    color: inherit;
    cursor: pointer;
    transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Once something is picked, the other sub-filters of that filter dim. */
  .catalog__filter[data-has-sub] .catalog__sub-btn[aria-pressed='false'] {
    opacity: 0.2;
  }

  .catalog__btn {
    font: inherit;
    color: inherit;
    cursor: pointer;
    text-decoration: none;
  }

  .catalog__bar > .catalog__btn:first-child {
    justify-self: start;
  }

  .catalog__cart {
    justify-self: end;
  }

  /* Filters: the active label is solid, the others at 20%, cross-fading over 0.3s. */
  .catalog__btn[data-filter-btn] {
    transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .catalog__btn[aria-pressed='false'][data-filter-btn] {
    opacity: 0.2;
  }

  .catalog__grid {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: 24px 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .catalog__grid[hidden],
  .catalog__tile[hidden] {
    display: none;
  }

  .catalog__link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: inherit;
    text-decoration: none;
  }

  /* Images are 20% smaller than their tile, centred, with the name centred underneath. */
  .catalog__image {
    width: 80%;
    aspect-ratio: 1;
    object-fit: contain;
    animation: catalog-fade 0.4s ease both;
  }

  /* Hover: the image grows to 1.02x over 300ms; its tile has a 200ms transform transition. */
  @media (prefers-reduced-motion: no-preference) {
    .catalog__tile {
      transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .catalog__image {
      transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .catalog__link:hover .catalog__image {
      transform: scale(1.02);
    }
  }

  .catalog__label {
    font-size: 1.125rem;
    text-align: center;
  }

  /* The tile image morphing into/out of the product page must not also fade in. */
  .catalog__image[data-view-transition-type] {
    animation: none;
  }

  @keyframes catalog-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .catalog__image {
      animation: none;
    }
  }
</style>

{% schema %}
{
  "name": "Catalog",
  "max_blocks": 10,
  "blocks": [
    {
      "type": "_catalog-filter"
    }
  ],
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "paragraph",
      "content": "Add up to 10 filters with Add Filter below. The first one is active when the page opens. Each filter can have sub-filters."
    },
    {
      "type": "select",
      "id": "sub_trigger",
      "label": "Show sub-filters on",
      "options": [
        {
          "value": "hover",
          "label": "Hover"
        },
        {
          "value": "click",
          "label": "Click"
        }
      ],
      "default": "hover",
      "info": "Touch screens always use click."
    },
    {
      "type": "select",
      "id": "sub_logic",
      "label": "Several sub-filters picked",
      "options": [
        {
          "value": "or",
          "label": "OR: products with any of them"
        },
        {
          "value": "and",
          "label": "AND: products with all of them"
        }
      ],
      "default": "or"
    }
  ],
  "presets": [
    {
      "name": "Catalog",
      "blocks": [
        {
          "type": "_catalog-filter",
          "settings": {
            "label": "MALE",
            "tag": "male"
          }
        },
        {
          "type": "_catalog-filter",
          "settings": {
            "label": "FEMALE",
            "tag": "female"
          }
        }
      ]
    }
  ]
}
{% endschema %}

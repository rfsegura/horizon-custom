{%- comment -%}
  Minimal catalog homepage: header bar (density "+", MALE/FEMALE toggle, bag) + product grid.
  The toggle shows/hides tiles client-side, so the URL stays "/". Tiles are filtered by product tag.
{%- endcomment -%}

<script
  type="module"
  src="{{ 'catalog-grid.js' | asset_url }}"
></script>
{%- liquid
  assign male_key = '|' | append: section.settings.male_tag | downcase | append: '|'
  assign female_key = '|' | append: section.settings.female_tag | downcase | append: '|'
-%}

<catalog-grid class="catalog" data-testid="catalog-{{ section.id }}">
  <header class="catalog__bar">
    <button
      type="button"
      class="catalog__btn button-unstyled"
      data-density
      aria-pressed="false"
      aria-label="Toggle grid size"
    >
      +
    </button>

    <div class="catalog__toggle" role="group" aria-label="Collection">
      <button type="button" class="catalog__btn button-unstyled" data-gender-btn="male" aria-pressed="true">
        {{- section.settings.male_label -}}
      </button>
      <button type="button" class="catalog__btn button-unstyled" data-gender-btn="female" aria-pressed="false">
        {{- section.settings.female_label -}}
      </button>
    </div>

    {% render 'catalog-cart-button', class: 'catalog__btn catalog__cart' %}
  </header>

  {%- comment -%} ponytail: a for-loop outside a paginate block returns at most 50 products. Raise via paginate if the catalog grows. {%- endcomment -%}
  <ul class="catalog__grid" role="list" data-main-grid>
    {%- for product in section.settings.collection.products limit: 50 -%}
      {%- assign tags = product.tags | join: '|' | downcase | prepend: '|' | append: '|' -%}
      {%- assign is_male = false -%}
      {%- assign is_female = false -%}
      {%- if tags contains male_key -%}{%- assign is_male = true -%}{%- endif -%}
      {%- if tags contains female_key -%}{%- assign is_female = true -%}{%- endif -%}

      {%- if is_male or is_female -%}
        {%- comment -%}
          One tile per Color option value (first available variant of that color, else its first variant).
          More than one color: the tile opens the color picker instead of the product page.
        {%- endcomment -%}
        {%- assign color_index = nil -%}
        {%- for option in product.options_with_values -%}
          {%- assign option_name = option.name | downcase -%}
          {%- if option_name == 'color' or option_name == 'colour' -%}
            {%- assign color_index = forloop.index0 -%}
          {%- endif -%}
        {%- endfor -%}

        {%- assign seen = '|' -%}
        {%- assign color_count = 0 -%}
        {%- capture color_tiles -%}
          {%- if color_index != nil -%}
            {%- for pass in (1..2) -%}
              {%- for variant in product.variants -%}
                {%- assign color = variant.options[color_index] -%}
                {%- assign color_key = color | downcase | prepend: '|' | append: '|' -%}
                {%- unless seen contains color_key -%}
                  {%- if pass == 2 or variant.available -%}
                    {%- assign seen = seen | append: color_key -%}
                    {%- assign color_count = color_count | plus: 1 -%}
                    <li class="catalog__tile">
                      {%- assign color_image = variant.featured_image | default: product.featured_image -%}
                      {%- assign color_alt = product.title | append: ' ' | append: color -%}
                      {% render 'catalog-tile', href: variant.url, image: color_image, title: product.title, alt: color_alt %}
                    </li>
                  {%- endif -%}
                {%- endunless -%}
              {%- endfor -%}
            {%- endfor -%}
          {%- endif -%}
        {%- endcapture -%}

        <li
          class="catalog__tile"
          data-gender="{% if is_male %}male{% endif %} {% if is_female %}female{% endif %}"
          {% unless is_male %}hidden{% endunless %}
        >
          {% render 'catalog-tile', href: product.url, image: product.featured_image, title: product.title, alt: product.title %}
          {%- if color_count > 1 -%}
            <template data-colors>{{ color_tiles }}</template>
          {%- endif -%}
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>

  <ul class="catalog__grid" role="list" data-color-grid hidden></ul>
</catalog-grid>

<style>
  /* Catalog homepage replaces the theme header and announcement bar. */
  #header-group {
    display: none;
  }

  .catalog {
    --cols: 6;
    display: block;
    min-height: 100vh;
    padding: 0 var(--padding-lg, 16px) 48px;
    font-family: var(--font-body--family);
    text-transform: uppercase;
  }

  .catalog[dense] {
    --cols: 3;
  }

  @media screen and (max-width: 749px) {
    .catalog {
      --cols: 3;
    }

    .catalog[dense] {
      --cols: 2;
    }
  }

  /* Faint peach glow around the screen edge. */
  .catalog::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: 5;
    pointer-events: none;
    box-shadow: inset 0 0 90px 10px rgb(255 190 160 / 0.35);
  }

  .catalog__bar {
    position: sticky;
    top: 0;
    z-index: 4;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 16px 0;
    background: var(--color-background);
  }

  .catalog__toggle {
    display: flex;
    gap: 24px;
  }

  .catalog__btn {
    font: inherit;
    color: inherit;
    cursor: pointer;
    text-decoration: none;
  }

  .catalog__bar > .catalog__btn:first-child {
    justify-self: start;
  }

  .catalog__cart {
    justify-self: end;
  }

  .catalog__btn[aria-pressed='false'][data-gender-btn] {
    opacity: 0.35;
  }

  .catalog__grid {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: 24px 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .catalog__grid[hidden],
  .catalog__tile[hidden] {
    display: none;
  }

  .catalog__link {
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: inherit;
    text-decoration: none;
  }

  .catalog__image {
    width: 100%;
    aspect-ratio: 1;
    object-fit: contain;
    animation: catalog-fade 0.4s ease both;
  }

  .catalog__label {
    font-size: 0.75rem;
  }

  @keyframes catalog-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .catalog__image {
      animation: none;
    }
  }
</style>

{% schema %}
{
  "name": "Catalog",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "male_label",
      "label": "First toggle label",
      "default": "MALE"
    },
    {
      "type": "text",
      "id": "male_tag",
      "label": "First toggle product tag",
      "default": "male"
    },
    {
      "type": "text",
      "id": "female_label",
      "label": "Second toggle label",
      "default": "FEMALE"
    },
    {
      "type": "text",
      "id": "female_tag",
      "label": "Second toggle product tag",
      "default": "female"
    }
  ],
  "presets": [
    {
      "name": "Catalog"
    }
  ]
}
{% endschema %}

{%- comment -%}
  Minimal top bar for every page except the homepage (the catalog section hides the header group there):
  a back arrow to "/" on the left and the bag on the right.
{%- endcomment -%}

<script
  type="module"
  src="{{ 'catalog-transitions.js' | asset_url }}"
></script>

{%- comment -%}
  Preload so the zoom never waits on the network: every product link (and the back arrow) is
  prefetched as soon as it is on screen, and fully prerendered when hovered or pressed. Browsers
  without Speculation Rules (Safari, Firefox) ignore this and just navigate normally.
{%- endcomment -%}
<script type="speculationrules">
  {
    "prefetch": [
      {
        "where": {
          "or": [
            { "href_matches": { "pathname": "/products/*" } },
            { "selector_matches": ".catalog-bar__back" }
          ]
        },
        "eagerness": "eager"
      }
    ],
    "prerender": [
      {
        "where": {
          "or": [
            { "href_matches": { "pathname": "/products/*" } },
            { "selector_matches": ".catalog-bar__back" }
          ]
        },
        "eagerness": "moderate"
      }
    ]
  }
</script>

{%- comment -%}
  Previous / next product for scroll and swipe on product pages: the neighbours in the homepage
  list the current product belongs to (same collection and gender tag as the catalog section), in
  the same order, wrapping around at the ends.
{%- endcomment -%}
{%- if template.name == 'product' and section.settings.collection != blank -%}
  {%- liquid
    assign male_key = '|' | append: section.settings.male_tag | downcase | append: '|'
    assign female_key = '|' | append: section.settings.female_tag | downcase | append: '|'
    assign current_tags = product.tags | join: '|' | downcase | prepend: '|' | append: '|'
    assign list_key = nil
    if current_tags contains male_key
      assign list_key = male_key
    elsif current_tags contains female_key
      assign list_key = female_key
    endif
  -%}

  {%- if list_key != nil -%}
    {%- capture list_urls -%}
      {%- for list_product in section.settings.collection.products limit: 50 -%}
        {%- assign list_tags = list_product.tags | join: '|' | downcase | prepend: '|' | append: '|' -%}
        {%- if list_tags contains list_key -%}{{ list_product.url }},{%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- assign url_list = list_urls | strip | split: ',' -%}

    {%- assign current_index = -1 -%}
    {%- for list_url in url_list -%}
      {%- if list_url == product.url -%}{%- assign current_index = forloop.index0 -%}{%- endif -%}
    {%- endfor -%}

    {%- if current_index >= 0 and url_list.size > 1 -%}
      {%- assign last_index = url_list.size | minus: 1 -%}
      {%- assign prev_index = current_index | minus: 1 -%}
      {%- assign next_index = current_index | plus: 1 -%}
      {%- if prev_index < 0 -%}{%- assign prev_index = last_index -%}{%- endif -%}
      {%- if next_index > last_index -%}{%- assign next_index = 0 -%}{%- endif -%}
      {%- assign prev_url = url_list[prev_index] -%}
      {%- assign next_url = url_list[next_index] -%}

      <span hidden data-catalog-prev="{{ prev_url }}" data-catalog-next="{{ next_url }}"></span>
      <script type="speculationrules">
        { "prerender": [{ "urls": [{{ prev_url | json }}, {{ next_url | json }}], "eagerness": "immediate" }] }
      </script>
    {%- endif -%}
  {%- endif -%}
{%- endif -%}

<div class="catalog-bar">
  <a href="{{ routes.root_url }}" class="catalog-bar__back" aria-label="{{ section.settings.back_label }}">
    {% render 'catalog-menu-icon', back: true %}
  </a>
  {% render 'catalog-cart-button', class: 'catalog-bar__cart' %}
</div>

<style>
  /* Always visible while scrolling (the scroll container is .page-wrapper on desktop, the page on mobile). */
  #header-group {
    position: sticky;
    top: 0;
    z-index: 4;
  }

  /*
    Product page: image on top, content underneath, at every width. This applies Horizon's mobile
    layout on tablet and desktop too. !important beats the left/right/equal-columns desktop rules in
    snippets/product-information-content.liquid without editing that upstream file.
  */
  @media screen and (min-width: 750px) {
    .product-information__grid {
      grid-template-columns: subgrid !important;
      grid-column: 1 / -1 !important;
    }

    .product-information__media,
    .product-details {
      grid-column: 2 / 3 !important;
      padding-inline: 0 !important;
      min-width: 0 !important;
      justify-self: center;
    }

    .product-information__media {
      order: 0 !important;
    }

    .product-details {
      position: static !important;
      order: 1 !important;
    }
  }

  /* Full-height product page: the first screen is exactly the viewport (minus the bar), with image
     and buy panel centered vertically. Taller content simply scrolls. */
  .product-information {
    min-height: calc(100dvh - 4rem);
    align-content: center;
  }

  /* Space reserved either side of the image for the arrows, so they never overlap it. */
  media-gallery slideshow-container {
    padding-inline: var(--arrow-gutter);
  }

  /* No dots or page counter under the image. */
  media-gallery slideshow-controls {
    display: none;
  }

  /*
    Desktop / laptop (990px and up): buy panel is 28.67% of the column, the image 25.6% plus its
    arrow gutters, both centered. The image is also capped by the viewport height so image + panel
    always fit on one screen.
  */
  @media screen and (min-width: 990px) {
    .product-information__media {
      --arrow-gutter: 7.2rem;

      width: calc(min(25.6%, (100dvh - 20rem) / 1.25) + 2 * var(--arrow-gutter)) !important;
    }

    .product-details {
      width: 28.67% !important;
    }
  }

  /*
    Phones and tablets (under 990px): the image area spans the screen and the image inside it is 80%
    of the screen width in portrait, 50% in landscape (the rest is the arrow gutters, in %).
  */
  @media screen and (max-width: 989px) {
    .product-information__media {
      --arrow-gutter: 10%;

      grid-column: 1 / -1 !important;
      width: 100% !important;
      min-width: 0 !important;
      justify-self: stretch;
    }
  }

  @media screen and (max-width: 989px) and (orientation: landscape) {
    .product-information__media {
      --arrow-gutter: 25%;
    }
  }

  /* Tablet in portrait: the image is 30% smaller than the phone size (80% x 0.7 = 56%). */
  @media screen and (min-width: 750px) and (max-width: 989px) and (orientation: portrait) {
    .product-information__media {
      --arrow-gutter: 22%;
    }
  }

  /* Horizon hides the product arrows on phones (it expects swipe + dots); with the dots gone the
     arrows are the only way to change image, so show them. */
  @media screen and (max-width: 749px) {
    media-gallery slideshow-arrows.mobile\:hidden {
      display: flex !important;
    }
  }

  /* Phones (under 750px): the buy panel uses the full width with 2rem either side. */
  @media screen and (max-width: 749px) {
    .product-details {
      grid-column: 1 / -1 !important;
      width: 100% !important;
      padding-inline: 2rem !important;
    }
  }

  /* Tablets (750px to 989px): the buy panel is 60% of the column. */
  @media screen and (min-width: 750px) and (max-width: 989px) {
    .product-details {
      width: 60% !important;
    }
  }

  /* Product image arrows: plain "<" and ">" characters instead of the icon. */
  /* Horizon mirrors the "previous" arrow with `scale: -1 1` (.flip-x); undo it so "<" isn't flipped into ">". */
  media-gallery .slideshow-control {
    scale: none;
    transform: none;
    font-size: 1.75rem;
    line-height: 1;
  }

  media-gallery .slideshow-control .svg-wrapper {
    display: none;
  }

  media-gallery .slideshow-control--previous::before {
    content: '<';
  }

  media-gallery .slideshow-control--next::before {
    content: '>';
  }

  /* Product page whose content fits the screen: scroll/swipe changes product instead of scrolling. */
  html.catalog-product-lock,
  html.catalog-product-lock body,
  html.catalog-product-lock .page-wrapper {
    overflow: hidden !important;
    touch-action: pan-x pinch-zoom;
  }

  /* Color picker open/close: 300ms, shared easing. */
  ::view-transition-group(root),
  ::view-transition-group(catalog-tile) {
    animation-duration: 0.3s;
    animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Tile <-> colorways: the other tiles vanish within 50ms, the colorways animate in over 0.3s. */
    html[data-catalog-picker]::view-transition-old(root) {
      animation: catalog-fade-out 50ms linear both;
      mix-blend-mode: normal;
    }

    html[data-catalog-picker]::view-transition-new(root) {
      animation: catalog-fade-in 0.3s cubic-bezier(0.4, 0, 0.2, 1) both;
      mix-blend-mode: normal;
    }

    /*
      Magnifying glass. Going to a product page, the grid (the old page) zooms in toward the clicked
      tile (1x -> 3.24x) and fades away while the clicked image itself (its own transition group)
      grows into the product image. Going back, it all reverses: the homepage zooms out from 3.24x
      to 1x and fades in while the image shrinks back into its tile.
    */
    html[data-catalog-nav] {
      --catalog-zoom-ease: cubic-bezier(0.22, 1, 0.36, 1);
    }

    html[data-catalog-nav]::view-transition-group(root-custom) {
      animation-duration: 0.35s;
      overflow: clip;
    }

    html[data-catalog-nav]::view-transition-group(product-image-transition) {
      animation-duration: 0.35s;
      animation-timing-function: var(--catalog-zoom-ease);
    }

    html[data-catalog-nav]::view-transition-old(root-custom),
    html[data-catalog-nav]::view-transition-new(root-custom) {
      mix-blend-mode: normal;
      transform-origin: var(--catalog-origin, 50% 50%);
    }

    html[data-catalog-nav='forward']::view-transition-old(root-custom) {
      animation:
        catalog-zoom-in 0.35s var(--catalog-zoom-ease) both,
        catalog-fade-out 0.3s linear both;
    }

    html[data-catalog-nav='forward']::view-transition-new(root-custom) {
      animation: catalog-fade-in 0.35s cubic-bezier(0.4, 0, 0.2, 1) both;
    }

    html[data-catalog-nav='back']::view-transition-old(root-custom) {
      animation: catalog-fade-out 0.25s linear both;
    }

    html[data-catalog-nav='back']::view-transition-new(root-custom) {
      animation:
        catalog-zoom-out 0.35s var(--catalog-zoom-ease) both,
        catalog-fade-in 0.35s cubic-bezier(0.4, 0, 0.2, 1) both;
    }

    /* Scrolling to the next / previous product: the page slides up / down and fades. */
    html[data-catalog-nav='next']::view-transition-old(root-custom) {
      animation: catalog-slide-out-up 0.35s var(--catalog-zoom-ease) both;
    }

    html[data-catalog-nav='next']::view-transition-new(root-custom) {
      animation: catalog-slide-in-up 0.35s var(--catalog-zoom-ease) both;
    }

    html[data-catalog-nav='prev']::view-transition-old(root-custom) {
      animation: catalog-slide-out-down 0.35s var(--catalog-zoom-ease) both;
    }

    html[data-catalog-nav='prev']::view-transition-new(root-custom) {
      animation: catalog-slide-in-down 0.35s var(--catalog-zoom-ease) both;
    }
  }

  @keyframes catalog-fade-in {
    from {
      opacity: 0;
    }
  }

  @keyframes catalog-fade-out {
    to {
      opacity: 0;
    }
  }

  @keyframes catalog-slide-out-up {
    to {
      translate: 0 -30%;
      opacity: 0;
    }
  }

  @keyframes catalog-slide-in-up {
    from {
      translate: 0 30%;
      opacity: 0;
    }
  }

  @keyframes catalog-slide-out-down {
    to {
      translate: 0 30%;
      opacity: 0;
    }
  }

  @keyframes catalog-slide-in-down {
    from {
      translate: 0 -30%;
      opacity: 0;
    }
  }

  @keyframes catalog-zoom-in {
    to {
      scale: 3.24;
    }
  }

  @keyframes catalog-zoom-out {
    from {
      scale: 3.24;
    }
  }

  .catalog-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px var(--padding-lg, 16px);
    font-family: var(--font-body--family);
    background: var(--color-background);
  }

  .catalog-bar__back {
    font-size: 1.5rem;
    line-height: 1;
    color: inherit;
    text-decoration: none;
  }

  .catalog-bar__cart {
    color: inherit;
    cursor: pointer;
  }

  /* Bold bag icon in the navigation bar (here and on the homepage bar). */
  .catalog-bar__cart,
  .catalog__cart {
    --icon-stroke-width: 2.5px;
  }
</style>

{% schema %}
{
  "name": "Back and bag bar",
  "settings": [
    {
      "type": "text",
      "id": "back_label",
      "label": "Back arrow accessibility label",
      "default": "Back to catalog"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Product list for scrolling between products (same collection as the homepage)"
    },
    {
      "type": "text",
      "id": "male_tag",
      "label": "First list product tag",
      "default": "male"
    },
    {
      "type": "text",
      "id": "female_tag",
      "label": "Second list product tag",
      "default": "female"
    }
  ]
}
{% endschema %}

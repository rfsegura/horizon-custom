{% doc %}
  The "+" / "<" icon made of two bars. Setting the `data-back` attribute on the span (from JS, or
  by passing `back: true`) rotates the "+" into the "<" with a CSS transition.

  @param {boolean} [back] - Render in the "<" state
{% enddoc %}

<span class="catalog-icon" aria-hidden="true"{% if back %} data-back{% endif %}><i></i><i></i></span>

{% stylesheet %}
  .catalog-icon {
    --ease: cubic-bezier(0.4, 0, 0.2, 1);

    position: relative;
    display: block;
    width: 24px;
    height: 24px;
  }

  .catalog-icon i {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 15px;
    height: 1px;
    background: currentcolor;
    transform: translate(-50%, -50%);
    transition:
      transform 0.3s var(--ease),
      top 0.3s var(--ease),
      width 0.3s var(--ease);
  }

  .catalog-icon i:last-child {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  /*
    "<": two arms meeting at the left. Arm length 10.6px at 45 degrees makes it 15px tall, the same
    as the "+" (each arm sits 3.75px above / below the middle).
  */
  .catalog-icon[data-back] i {
    top: calc(50% - 3.75px);
    width: 10.6px;
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  .catalog-icon[data-back] i:last-child {
    top: calc(50% + 3.75px);
    transform: translate(-50%, -50%) rotate(45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .catalog-icon i {
      transition: none;
    }
  }
{% endstylesheet %}

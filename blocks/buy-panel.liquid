{%- doc -%}
  Yeezy-style buy panel for the product page: name, price and "+". The "+" opens a size picker in
  place ("SELECT SIZE"); clicking a size adds that variant to the cart; "INFORMATION" shows the
  description; "X" closes. Replaces the title, price, variant picker, buy buttons and description blocks.
  Sizes shown are the variants sharing the selected variant's Color option.
{%- enddoc -%}

{%- liquid
  assign product = closest.product
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif

  assign selected = product.selected_or_first_available_variant

  assign size_index = nil
  assign color_index = nil
  for option in product.options_with_values
    assign option_name = option.name | downcase
    if option_name == 'size' or option_name == 'sizes'
      assign size_index = forloop.index0
    elsif option_name == 'color' or option_name == 'colour'
      assign color_index = forloop.index0
    endif
  endfor

  assign any_available = false
  assign size_count = 0
-%}

{%- capture size_buttons -%}
  {%- for variant in product.variants -%}
    {%- liquid
      assign same_color = true
      if color_index != nil and variant.options[color_index] != selected.options[color_index]
        assign same_color = false
      endif
    -%}
    {%- if same_color -%}
      {%- liquid
        if size_index != nil
          assign label = variant.options[size_index]
        else
          assign label = variant.title
        endif
        if label == 'Default Title'
          assign label = 'One size'
        endif
        if variant.available
          assign any_available = true
        endif

        assign size_count = size_count | plus: 1

        # Shown instead of the size while "?" is hovered (cosmetic). Falls back to the size itself.
        assign numeral = variant.metafields.custom.variant_size.value | default: label
      -%}
      <button
        type="button"
        class="buy-panel__size button-unstyled"
        data-action="size"
        data-variant-id="{{ variant.id }}"
        style="--i: {{ size_count | minus: 1 }}"
        aria-label="{{ label | upcase }}"
        {% unless variant.available %}
          disabled
        {% endunless %}
      >
        <span class="buy-panel__label" aria-hidden="true">{{ label | upcase }}</span>
        <span class="buy-panel__numeral" aria-hidden="true">{{ numeral }}</span>
      </button>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- comment -%}
  Colors of this product in option order, one link per color (its first variant), for scrolling
  between colors on the product page (assets/catalog-transitions.js). Printed inside the section so
  every swapped-in page brings its own list.
{%- endcomment -%}
{%- assign color_count = 0 -%}
{%- assign current_color = 0 -%}
{%- assign seen_colors = '|' -%}
{%- capture colors_json -%}
  {%- if color_index != nil -%}
    {%- for variant in product.variants -%}
      {%- assign color = variant.options[color_index] -%}
      {%- assign color_key = color | downcase | prepend: '|' | append: '|' -%}
      {%- unless seen_colors contains color_key -%}
        {%- assign seen_colors = seen_colors | append: color_key -%}
        {%- if color == selected.options[color_index] -%}{%- assign current_color = color_count -%}{%- endif -%}
        {%- if color_count > 0 -%},{%- endif -%}
        {"n":{{ color | json }},"u":{{ variant.url | json }}}
        {%- assign color_count = color_count | plus: 1 -%}
      {%- endunless -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

{%- if product != blank -%}
  <script
    type="module"
    src="{{ 'buy-panel.js' | asset_url }}"
  ></script>

  {%- if color_count > 1 -%}
    <script
      type="application/json"
      data-catalog-colors
      data-current="{{ current_color }}"
      data-wrap="{{ block.settings.wrap }}"
    >
      [{{ colors_json }}]
    </script>
  {%- endif -%}

  <buy-panel
    class="buy-panel"
    data-state="default"
    {{ block.shopify_attributes }}
  >
    <product-form-component
      data-section-id="{{ section.id }}"
      data-product-id="{{ product.id }}"
      data-product-url="{{ product.url }}"
      on:submit="/handleSubmit"
      data-quantity-default="1"
    >
      <div
        class="visually-hidden"
        aria-live="assertive"
        role="status"
        aria-atomic="true"
        ref="liveRegion"
      ></div>
      {%- form 'product', product, id: 'BuyPanel-ProductForm', data-type: 'add-to-cart-form' -%}
        <input
          type="hidden"
          name="id"
          ref="variantId"
          value="{{ selected.id }}"
        >
      {%- endform -%}
    </product-form-component>

    <div class="buy-panel__head" data-fade>
      <button
        type="button"
        class="buy-panel__help button-unstyled"
        data-show="size info adding"
        aria-label="Show numeric sizes"
      >
        ?
      </button>
      <span class="buy-panel__title" data-show="default">{{ product.title | upcase }}</span>
      <span class="buy-panel__title" data-show="size info adding">{{ 'Select size' | upcase }}</span>
      <button
        type="button"
        class="buy-panel__close button-unstyled"
        data-action="close"
        data-show="size info adding"
        aria-label="Close"
      >
        &times;
      </button>
    </div>

    <p class="buy-panel__price">{% render 'format-price', price: selected.price %}</p>

    <div class="buy-panel__action" data-fade>
      {%- if any_available -%}
        <button
          type="button"
          class="buy-panel__plus button-unstyled"
          data-action="open"
          data-show="default"
          aria-label="Select size"
        >
          +
        </button>
      {%- else -%}
        <span class="buy-panel__sold-out" data-show="default">{{ 'products.product.sold_out' | t | upcase }}</span>
      {%- endif -%}

      {%- comment -%}
        The size, adding and info panes share one grid cell so the size row can fade out while the
        information text fades in at the same moment, in the same place.
      {%- endcomment -%}
      <div class="buy-panel__stack" data-show="size info adding">
        <div class="buy-panel__pane buy-panel__pane--size" data-show="size">
          <div class="buy-panel__sizes" role="group" aria-label="Select size" style="--n: {{ size_count }}">
            {{ size_buttons }}
          </div>
          <button
            type="button"
            class="buy-panel__info-link button-unstyled"
            data-action="info"
          >
            {{ 'Information' | upcase }}
          </button>
        </div>

        <div class="buy-panel__pane buy-panel__pane--adding" data-show="adding" aria-live="polite">
          {{ 'Adding' | upcase }}
        </div>

        <div class="buy-panel__pane buy-panel__pane--info buy-panel__info" data-show="info">
          {{ product.description }}
        </div>
      </div>
    </div>
  </buy-panel>
{%- endif -%}

{% stylesheet %}
  .buy-panel {
    --ease: cubic-bezier(0.4, 0, 0.2, 1);

    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    font-size: 1.125rem;
    text-align: center;
    text-transform: uppercase;
  }

  .buy-panel__head {
    position: relative;
    width: 100%;
  }

  .buy-panel__close,
  .buy-panel__help {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    font-size: 1.75rem;
    line-height: 1;
    cursor: pointer;
  }

  .buy-panel__close {
    right: 0;
  }

  .buy-panel__help {
    left: 0;
  }

  /*
    "Radial slide up": content rolls like a drum. Incoming content starts tipped back and below and
    rolls up to flat; outgoing content rolls up and away. Used by the "?" size swap.
  */
  .buy-panel {
    --roll-in: perspective(300px) rotateX(-70deg) translateY(0.8em);
    --roll-out: perspective(300px) rotateX(70deg) translateY(-0.8em);
  }

  /* Each size holds its label and its numeral in one grid cell; "?" rolls one out and the other in. */
  .buy-panel__size {
    display: inline-grid;
    transform-origin: 50% 50%;
    animation: buy-panel-spread 0.3s var(--ease) both;
  }

  .buy-panel__label,
  .buy-panel__numeral {
    grid-area: 1 / 1;
    transition:
      transform 0.3s var(--ease),
      opacity 0.3s var(--ease);
  }

  .buy-panel__numeral {
    opacity: 0;
    transform: var(--roll-in);
  }

  /* Hovering "?" swaps every size to its numeral; hovering one size swaps only that size. */
  .buy-panel:has(.buy-panel__help:is(:hover, :focus-visible)) .buy-panel__label,
  .buy-panel__size:is(:hover, :focus-visible) .buy-panel__label {
    opacity: 0;
    transform: var(--roll-out);
  }

  .buy-panel:has(.buy-panel__help:is(:hover, :focus-visible)) .buy-panel__numeral,
  .buy-panel__size:is(:hover, :focus-visible) .buy-panel__numeral {
    opacity: 1;
    transform: none;
  }

  .buy-panel__price,
  .buy-panel__info {
    margin: 0;
  }

  .buy-panel__plus {
    font-size: 1.75rem;
    line-height: 1;
    cursor: pointer;
  }

  /*
    Sizes span the full width of the panel: the first sits under the "?", the last under the "X", and
    the ones between are spaced evenly. --n is the number of sizes, --i this size's position.
  */
  .buy-panel__sizes {
    container-type: inline-size;
    display: flex;
    justify-content: space-between;
    width: 100%;
  }

  .buy-panel__size:only-child {
    margin-inline: auto;
    animation: none;
  }

  /* Sizes start bunched in the middle (offset by their distance from it), faint, and slide out. */
  @keyframes buy-panel-spread {
    from {
      translate: calc((0.5 - var(--i) / max(var(--n) - 1, 1)) * (100cqw - 1.5em)) 0;
      opacity: 0.3;
    }
  }

  /* "INFORMATION" starts a few pixels higher and drops into place as the sizes settle. */
  @keyframes buy-panel-drop {
    from {
      translate: 0 -4px;
    }
  }

  .buy-panel__size,
  .buy-panel__info-link {
    cursor: pointer;
  }

  .buy-panel__size:disabled {
    opacity: 0.3;
    text-decoration: line-through;
    cursor: not-allowed;
  }

  .buy-panel__info-link {
    display: block;
    margin: 12px auto 0;
    text-decoration: underline;
    animation: buy-panel-drop 0.3s var(--ease) both;
  }

  /* The size, adding and info panes overlap in one grid cell so they can crossfade in place. */
  .buy-panel__pane {
    grid-area: 1 / 1;
  }

  /*
    Fixed-height area under the price. Every state (+, sizes, information) lives inside it, so opening
    or closing never changes the panel height and the name, price and image stay perfectly still.
    Long descriptions scroll inside it.
  */
  .buy-panel__action {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    height: 8rem;
  }

  .buy-panel__stack {
    width: 100%;
    max-height: 100%;
  }

  .buy-panel__pane--info {
    max-height: 8rem;
    overflow-y: auto;
    scrollbar-width: none;
  }

  /* Information text fades in from faint grey to full colour as the size row fades out. */
  .buy-panel__info {
    animation: buy-panel-in 0.35s var(--ease) both;
  }

  /* INFORMATION: plain fade and slide up. */
  @keyframes buy-panel-in {
    from {
      opacity: 0;
      color: gray;
      translate: 0 1rem;
    }
  }

  @keyframes buy-panel-out {
    to {
      opacity: 0;
      translate: 0 -1rem;
    }
  }

  /* While the info text fades in, keep the size pane on screen just long enough to fade out. */
  .buy-panel[data-leaving] .buy-panel__pane--size {
    display: block;
    animation: buy-panel-out 0.35s var(--ease) both;
  }

  .buy-panel[data-leaving] .buy-panel__size,
  .buy-panel[data-leaving] .buy-panel__info-link {
    animation: none;
  }

  .buy-panel__pane--adding {
    text-align: center;
  }

  /* Only the elements for the current state are shown. */
  .buy-panel [data-show] {
    display: none;
  }

  .buy-panel[data-state='default'] [data-show~='default'],
  .buy-panel[data-state='size'] [data-show~='size'],
  .buy-panel[data-state='info'] [data-show~='info'],
  .buy-panel[data-state='adding'] [data-show~='adding'] {
    display: revert;
  }

  .buy-panel:not([data-state='default']) .buy-panel__stack {
    display: grid;
  }

  /* Only closing fades out then in: the JS swaps data-state while .is-fading is set. Opening is instant. */
  .buy-panel [data-fade] {
    transition: opacity 0.15s var(--ease);
  }

  .buy-panel.is-fading [data-fade] {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .buy-panel [data-fade] {
      transition: none;
    }

    .buy-panel__info,
    .buy-panel__size,
    .buy-panel__info-link,
    .buy-panel[data-leaving] .buy-panel__pane--size {
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Buy panel",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "wrap",
      "label": "Scrolling past the last / first color wraps around",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Buy panel"
    }
  ]
}
{% endschema %}
